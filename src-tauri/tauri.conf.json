{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Taskette",
  "version": "0.4.1",
  "identifier": "ai.latelatte.taskette",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Taskette",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5MENGMDBCNjQyRURENTMKUldSVDNTNWtDL0FNK1QxWng2THZBWDB3K3pWa3JMelpFYjloS1l4UWN2VkRGMGQ1K1N1K1RYSWYK",
      "endpoints": [
        "https://github.com/latelatte/taskette/releases/latest/download/latest.json"
      ]
    }
  }
}
